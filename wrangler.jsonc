{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo-no-kotoba",
  // Cloudflare account: set CLOUDFLARE_ACCOUNT_ID in the environment instead of
  // committing an account identifier. See CONTRIBUTING.md.
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
